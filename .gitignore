# Raw and large intermediate data; keep directory placeholders
data/raw_videos/*
!data/raw_videos/.gitkeep
data/frames/*
!data/frames/.gitkeep
data/openpose/raw_json/*
!data/openpose/raw_json/.gitkeep

# Generated results; explicitly retain the declared directory skeleton
results/*
!results/mot/
!results/openpose/
!results/figures/
!results/tables/
results/mot/*
results/openpose/*
results/figures/*
results/tables/*
!results/mot/.gitkeep
!results/openpose/.gitkeep
!results/figures/.gitkeep
!results/tables/.gitkeep

